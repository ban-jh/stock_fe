{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "resolveJsonModule": true, "isolatedModules": true, "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client"], "baseUrl": ".", "paths": {"@/*": ["./src/*"]}
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}